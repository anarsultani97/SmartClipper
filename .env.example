# Local review build: run one API and one worker, both from repo root.
SMARTCLIPPER_DATA_DIR=data
SMARTCLIPPER_DATABASE_URL=sqlite:///data/smartclipper.db
SMARTCLIPPER_MAX_UPLOAD_BYTES=3221225472
SMARTCLIPPER_MAX_DURATION_SECONDS=1800
SMARTCLIPPER_MAX_AUDIO_BYTES=20971520
SMARTCLIPPER_MAX_LINK_IMPORTS=2
# Use installed binaries on PATH, or set absolute paths.
SMARTCLIPPER_FFMPEG_PATH=ffmpeg
SMARTCLIPPER_FFPROBE_PATH=ffprobe

# Local multilingual transcription. Model weights are downloaded once into ignored data/models.
SMARTCLIPPER_WHISPER_MODEL=base
SMARTCLIPPER_WHISPER_DEVICE=cpu
SMARTCLIPPER_WHISPER_COMPUTE_TYPE=int8

# Optional hosted semantic ranking. Disabled means transcript text remains local.
# Choose an API model available to your account; development profiles do not select it.
SMARTCLIPPER_HOSTED_RANKING_ENABLED=false
SMARTCLIPPER_OPENAI_API_KEY=
SMARTCLIPPER_RANKING_MODEL=

# Register this exact public origin and each /api/v1/auth/{provider}/callback with providers.
SMARTCLIPPER_PUBLIC_URL=http://127.0.0.1:5173
SMARTCLIPPER_GOOGLE_CLIENT_ID=
SMARTCLIPPER_GOOGLE_CLIENT_SECRET=
SMARTCLIPPER_FACEBOOK_CLIENT_ID=
SMARTCLIPPER_FACEBOOK_CLIENT_SECRET=
# Use a version supported by your registered Meta app (for example vXX.X); not a guessed default.
SMARTCLIPPER_FACEBOOK_API_VERSION=

# For a future HTTPS deployment: strong persistent secret, secure cookies, configured origins/hosts.
SMARTCLIPPER_SESSION_SECRET=
SMARTCLIPPER_SECURE_COOKIES=false
SMARTCLIPPER_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
SMARTCLIPPER_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Existing authenticated account IDs only; never grant operator rights by unverified email.
SMARTCLIPPER_ANALYTICS_ADMIN_USER_IDS=[]
